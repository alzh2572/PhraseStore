# ============================================================
# LOCAL (dev) — npm run dev / prisma migrate dev / view-db local
# ============================================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/phrasestore?sslmode=disable"
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/phrasestore?sslmode=disable"
DATABASE_URL_LOCAL="postgresql://postgres:postgres@localhost:5432/phrasestore?sslmode=disable"

# ============================================================
# REMOTE (Neon) — для view-db «рабочая БД»
# ============================================================
DATABASE_URL_REMOTE="postgresql://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# ============================================================
# Auth.js — Google OAuth
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://YOUR-APP.vercel.app/api/auth/callback/google
# ============================================================
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# openssl rand -base64 32
AUTH_SECRET=""
# Публичный URL (локально / Vercel)
AUTH_URL="http://localhost:3000"

# ============================================================
# PRODUCTION (Vercel) — Environment Variables
# ============================================================
# DATABASE_URL=...pooler...
# DATABASE_URL_UNPOOLED=...direct...
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET / AUTH_SECRET / AUTH_URL
